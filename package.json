{
  "name": "nar_api",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.11.0"
  },
  "bin": {
    "nar_api": "bin/nar_api.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "TZ=UTC vitest run",
    "cdk": "cdk",
    "synth": "npm run compile && cdk synth",
    "deploy": "npm run compile && cdk deploy --require-approval never",
    "lint": "eslint .",
    "compile": "tsc",
    "fix": "eslint . --fix",
    "_prepare": "npm run compile",
    "pretest": "npm run synth > /dev/null",
    "posttest": "npm run lint"
  },
  "devDependencies": {
    "@smithy/util-stream": "^4.8.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "aws-cdk": "^2.1141.0",
    "aws-sdk-client-mock": "^4.0.1",
    "aws-sdk-client-mock-vitest": "^7.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "neostandard": "^0.13.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-sfn": "^3.1130.0",
    "@aws-sdk/lib-storage": "^3.1130.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@middy/core": "^7.9.2",
    "aws-cdk-lib": "^2.268.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "constructs": "^10.8.1",
    "express": "^5.2.1",
    "luxon": "^3.7.2"
  }
}
